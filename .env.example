# =========================================================================
# CONFIGURACIÓN PARA DESPLIEGUE EN PRODUCCIÓN (SUPABASE + VERCEL)
# =========================================================================

# 1. Base de Datos PostgreSQL (Supabase)
# Reemplaza [YOUR-PASSWORD] y [PROJECT-REF] con tus datos de Supabase:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# 2. Clave secreta para sesiones JWT seguras
JWT_SECRET="genera-un-texto-aleatorio-seguro-aqui-para-tu-empresa-2026"

# 3. Supabase Storage (Para subida de videos y briefs a la nube)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-de-supabase"
SUPABASE_STORAGE_BUCKET="sp-commercial-files"

# 4. URL del sitio web desplegado
NEXT_PUBLIC_APP_URL="https://tu-dominio.vercel.app"
